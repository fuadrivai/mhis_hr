APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.1
# OPENAI_REASONING_EFFORT=low
AI_TIMEOUT=45
AI_MANDATORY_SCORE_CAP=60
# PYTHON_BINARY=/usr/bin/python3

RECRUITMENT_SEND_INTERVIEW_EMAIL=false
RECRUITMENT_MAIL_MAILER=smtp
RECRUITMENT_MAIL_HOST=smtp.mailgun.org
RECRUITMENT_MAIL_PORT=587
RECRUITMENT_MAIL_USERNAME=null
RECRUITMENT_MAIL_PASSWORD=null
RECRUITMENT_MAIL_ENCRYPTION=tls
RECRUITMENT_MAIL_FROM_ADDRESS="recruitment@mutiaraharapan.sch.id"
RECRUITMENT_MAIL_FROM_NAME="${APP_NAME} Recruitment"
